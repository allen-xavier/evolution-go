+++ b/pkg/whatsmeow/service/media_download_retry_test.go
@@ -0,0 +1,58 @@
+package whatsmeow_service
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net/url"
+	"testing"
+
+	"go.mau.fi/whatsmeow"
+	"go.mau.fi/whatsmeow/proto/waE2E"
+)
+
+func TestRetryableMediaDownloadError(t *testing.T) {
+	proxyErr := &url.Error{Op: "Get", URL: "https://mmg.whatsapp.net/v/t62", Err: errors.New("NO_HOST_CONNECTION")}
+	cases := []struct {
+		name string
+		err  error
+		want bool
+	}{
+		{"nil", nil, false},
+		{"proxy without connection", proxyErr, true},
+		{"proxy wrapped by whatsmeow", fmt.Errorf("failed to download media from last host: %w", proxyErr), true},
+		{"http2 stream error", errors.New("stream error: stream ID 3; INTERNAL_ERROR"), true},
+		{"expired media", whatsmeow.ErrMediaDownloadFailedWith404, false},
+		{"gone media", whatsmeow.ErrMediaDownloadFailedWith410, false},
+		{"invalid hmac", whatsmeow.ErrInvalidMediaHMAC, false},
+		{"canceled", context.Canceled, false},
+		{"deadline", context.DeadlineExceeded, false},
+	}
+	for _, c := range cases {
+		if got := retryableMediaDownloadError(c.err); got != c.want {
+			t.Errorf("%s: got %v, want %v", c.name, got, c.want)
+		}
+	}
+}
+
+func TestMediaDownloadRetryTarget(t *testing.T) {
+	doc := &waE2E.DocumentMessage{}
+	if got := mediaDownloadRetryTarget(nil, nil, doc, nil, nil, nil, nil, nil, nil); got != doc {
+		t.Errorf("document: got %v", got)
+	}
+	img := &waE2E.ImageMessage{}
+	if got := mediaDownloadRetryTarget(img, nil, doc, nil, nil, nil, nil, nil, nil); got != img {
+		t.Errorf("image comes first: got %v", got)
+	}
+	sticker := &waE2E.StickerMessage{}
+	if got := mediaDownloadRetryTarget(nil, nil, nil, nil, sticker, img, nil, nil, nil); got != nil {
+		t.Errorf("sticker: got %v, want nil", got)
+	}
+	assocDoc := &waE2E.DocumentMessage{}
+	if got := mediaDownloadRetryTarget(nil, nil, nil, nil, nil, nil, nil, assocDoc, nil); got != assocDoc {
+		t.Errorf("associated document: got %v", got)
+	}
+	if got := mediaDownloadRetryTarget(nil, nil, nil, nil, nil, nil, nil, nil, nil); got != nil {
+		t.Errorf("no media: got %v, want nil", got)
+	}
+}
