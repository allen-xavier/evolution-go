diff --git a/pkg/whatsmeow/service/media_download_retry.go b/pkg/whatsmeow/service/media_download_retry.go
new file mode 100644
index 0000000..75d930a
--- /dev/null
+++ b/pkg/whatsmeow/service/media_download_retry.go
@@ -0,0 +1,65 @@
+package whatsmeow_service
+
+import (
+	"context"
+	"errors"
+	"net"
+	"strings"
+	"time"
+
+	"go.mau.fi/whatsmeow"
+	"go.mau.fi/whatsmeow/proto/waE2E"
+)
+
+// mediaDownloadRetryDelays are the pauses before each extra download attempt of
+// an incoming media message. whatsmeow already retries a few times within about
+// 15 seconds; these extra attempts cover longer network or proxy hiccups.
+var mediaDownloadRetryDelays = []time.Duration{5 * time.Second, 15 * time.Second}
+
+// retryableMediaDownloadError reports whether a failed media download is worth
+// trying again: network errors are, while expired, missing or corrupted media
+// (HTTP 403/404/410, invalid hmac or hash) and cancellations are not.
+func retryableMediaDownloadError(err error) bool {
+	if err == nil || errors.Is(err, context.Canceled) || errors.Is(err, context.DeadlineExceeded) {
+		return false
+	}
+	var netErr net.Error
+	return errors.As(err, &netErr) || strings.HasPrefix(err.Error(), "stream error:")
+}
+
+// mediaDownloadRetryTarget returns the media the incoming message handler
+// downloaded, following the same order as the handler. Stickers return nil:
+// they need a conversion after the download and are not worth a retry.
+func mediaDownloadRetryTarget(
+	img *waE2E.ImageMessage,
+	audio *waE2E.AudioMessage,
+	document *waE2E.DocumentMessage,
+	video *waE2E.VideoMessage,
+	sticker *waE2E.StickerMessage,
+	associatedImg *waE2E.ImageMessage,
+	associatedAudio *waE2E.AudioMessage,
+	associatedDocument *waE2E.DocumentMessage,
+	associatedVideo *waE2E.VideoMessage,
+) whatsmeow.DownloadableMessage {
+	switch {
+	case img != nil:
+		return img
+	case audio != nil:
+		return audio
+	case document != nil:
+		return document
+	case video != nil:
+		return video
+	case sticker != nil:
+		return nil
+	case associatedImg != nil:
+		return associatedImg
+	case associatedAudio != nil:
+		return associatedAudio
+	case associatedDocument != nil:
+		return associatedDocument
+	case associatedVideo != nil:
+		return associatedVideo
+	}
+	return nil
+}
