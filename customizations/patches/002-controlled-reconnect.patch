--- /dev/null
+++ b/pkg/whatsmeow/service/reconnect_policy_test.go
@@ -0,0 +1,27 @@
+package whatsmeow_service
+
+import (
+	"testing"
+	"time"
+)
+
+func TestReconnectDelayUsesExponentialBackoffWithCap(t *testing.T) {
+	tests := []struct {
+		attempt int
+		want    time.Duration
+	}{
+		{attempt: 0, want: 15 * time.Second},
+		{attempt: 1, want: 30 * time.Second},
+		{attempt: 2, want: time.Minute},
+		{attempt: 3, want: 2 * time.Minute},
+		{attempt: 4, want: 4 * time.Minute},
+		{attempt: 5, want: 5 * time.Minute},
+		{attempt: 20, want: 5 * time.Minute},
+	}
+
+	for _, test := range tests {
+		if got := reconnectDelay(test.attempt); got != test.want {
+			t.Fatalf("attempt %d: expected %s, got %s", test.attempt, test.want, got)
+		}
+	}
+}
