+func reconnectDelay(attempt int) time.Duration {
+	if attempt < 0 {
+		attempt = 0
+	}
+	delay := 15 * time.Second
+	for step := 0; step < attempt && delay < 5*time.Minute; step++ {
+		delay *= 2
+		if delay > 5*time.Minute {
+			delay = 5 * time.Minute
+		}
+	}
+	return delay
+}
+
+func (w whatsmeowService) SetReconnectTerminal(instanceId string, terminal bool) {
+	if terminal {
+		w.reconnectTerminal.Store(instanceId, true)
+		return
+	}
+	w.reconnectTerminal.Delete(instanceId)
+}
+
+func (w whatsmeowService) ScheduleReconnect(instanceId string) {
+	if _, terminal := w.reconnectTerminal.Load(instanceId); terminal {
+		w.loggerWrapper.GetLogger(instanceId).LogWarn("[%s] Automatic reconnect skipped because the session is in a terminal state", instanceId)
+		return
+	}
+	if _, alreadyRunning := w.reconnectRunning.LoadOrStore(instanceId, true); alreadyRunning {
+		w.loggerWrapper.GetLogger(instanceId).LogInfo("[%s] Reconnect scheduler already running", instanceId)
+		return
+	}
+
+	go func() {
+		defer w.reconnectRunning.Delete(instanceId)
+		for attempt := 0; ; attempt++ {
+			delay := reconnectDelay(attempt)
+			w.loggerWrapper.GetLogger(instanceId).LogInfo("[%s] Next reconnect attempt in %s", instanceId, delay)
+			time.Sleep(delay)
+
+			if _, terminal := w.reconnectTerminal.Load(instanceId); terminal {
+				w.loggerWrapper.GetLogger(instanceId).LogWarn("[%s] Reconnect scheduler stopped by terminal session state", instanceId)
+				return
+			}
+
+			instance, err := w.instanceRepository.GetInstanceByID(instanceId)
+			if err != nil {
+				w.loggerWrapper.GetLogger(instanceId).LogInfo("[%s] Reconnect scheduler stopped because the instance no longer exists", instanceId)
+				return
+			}
+			if instance.Connected {
+				w.loggerWrapper.GetLogger(instanceId).LogInfo("[%s] Reconnect scheduler stopped after a successful connection", instanceId)
+				return
+			}
+
+			w.loggerWrapper.GetLogger(instanceId).LogInfo("[%s] Running reconnect attempt %d", instanceId, attempt+1)
+			if err := w.ReconnectClient(instanceId); err != nil {
+				w.loggerWrapper.GetLogger(instanceId).LogError("[%s] Reconnect attempt %d failed: %v", instanceId, attempt+1, err)
+			}
+		}
+	}()
+}
