+func (w whatsmeowService) lifecycleLock(instanceID string) *sync.Mutex {
+	lock, _ := w.lifecycleLocks.LoadOrStore(instanceID, &sync.Mutex{})
+	return lock.(*sync.Mutex)
+}
+
+func signalClientStop(stopChannel chan bool) {
+	if stopChannel == nil {
+		return
+	}
+	select {
+	case stopChannel <- true:
+	default:
+	}
+}
+
+func waitForClientReady(ready <-chan error, timeout time.Duration) error {
+	if ready == nil {
+		return errors.New("client readiness channel is not configured")
+	}
+	select {
+	case err := <-ready:
+		return err
+	case <-time.After(timeout):
+		return fmt.Errorf("client did not become ready within %s", timeout)
+	}
+}
+
+func (mycli *MyClient) signalReady(err error) {
+	if mycli == nil || mycli.ready == nil || mycli.readyOnce == nil {
+		return
+	}
+	mycli.readyOnce.Do(func() {
+		mycli.ready <- err
+	})
+}
+
+func (w whatsmeowService) cleanupClientRuntime(instanceID string, client *whatsmeow.Client, mycli *MyClient, stopChannel chan bool) {
+	w.runtimeMu.Lock()
+	defer w.runtimeMu.Unlock()
+
+	if current := w.clientPointer[instanceID]; current == client {
+		delete(w.clientPointer, instanceID)
+	}
+	if current := w.myClientPointer[instanceID]; current == mycli {
+		delete(w.myClientPointer, instanceID)
+	}
+	if current := w.killChannel[instanceID]; current == stopChannel {
+		delete(w.killChannel, instanceID)
+	}
+}
+
 func (w whatsmeowService) ReconnectClient(instanceId string) error {
 	if _, terminal := w.reconnectTerminal.Load(instanceId); terminal {
 		return fmt.Errorf("automatic reconnect blocked by terminal session state")
 	}
 
+	lock := w.lifecycleLock(instanceId)
+	lock.Lock()
+	defer lock.Unlock()
+
+	w.loggerWrapper.GetLogger(instanceId).LogInfo("[%s] Starting generation-safe reconnection", instanceId)
+
+	w.runtimeMu.Lock()
+	oldClient := w.clientPointer[instanceId]
+	oldMyClient := w.myClientPointer[instanceId]
+	oldStop := w.killChannel[instanceId]
+	w.runtimeMu.Unlock()
+	oldDoneValue, hasOldDone := w.clientDone.Load(instanceId)
+
+	if oldClient != nil && oldMyClient != nil && oldMyClient.eventHandlerID != 0 {
+		oldClient.RemoveEventHandler(oldMyClient.eventHandlerID)
+		w.loggerWrapper.GetLogger(instanceId).LogInfo("[%s] Previous event handler removed", instanceId)
+	}
+	signalClientStop(oldStop)
+	if oldClient != nil && oldClient.IsConnected() {
+		oldClient.Disconnect()
+	}
+	if hasOldDone {
+		select {
+		case <-oldDoneValue.(chan struct{}):
+		case <-time.After(clientShutdownTimeout):
+			w.loggerWrapper.GetLogger(instanceId).LogWarn("[%s] Previous client did not stop within %s; continuing with generation isolation", instanceId, clientShutdownTimeout)
+		}
+	}
+	w.cleanupClientRuntime(instanceId, oldClient, oldMyClient, oldStop)
+	if current, ok := w.clientDone.Load(instanceId); ok && (!hasOldDone || current == oldDoneValue) {
+		w.clientDone.Delete(instanceId)
+	}
+
+	if instance, err := w.instanceRepository.GetInstanceByID(instanceId); err == nil {
+		w.userInfoCache.Delete(instance.Token)
+	}
+	if err := w.instanceRepository.UpdateConnected(instanceId, false, "Reconnecting"); err != nil {
+		w.loggerWrapper.GetLogger(instanceId).LogWarn("[%s] Failed to update disconnect status: %v", instanceId, err)
+	}
+	if err := w.instanceRepository.UpdateQrcode(instanceId, ""); err != nil {
+		w.loggerWrapper.GetLogger(instanceId).LogWarn("[%s] Failed to clear stale QR code during reconnect: %v", instanceId, err)
+	}
+
+	return w.startInstanceLocked(instanceId)
+}
