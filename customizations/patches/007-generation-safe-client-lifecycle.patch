diff --git a/pkg/whatsmeow/service/client_lifecycle_test.go b/pkg/whatsmeow/service/client_lifecycle_test.go
new file mode 100644
index 0000000..697bb53
--- /dev/null
+++ b/pkg/whatsmeow/service/client_lifecycle_test.go
@@ -0,0 +1,97 @@
+package whatsmeow_service
+
+import (
+	"errors"
+	"sync"
+	"testing"
+	"time"
+
+	"go.mau.fi/whatsmeow"
+)
+
+func TestSignalClientStopIsNonBlockingAndIdempotent(t *testing.T) {
+	stop := make(chan bool, 1)
+
+	signalClientStop(stop)
+	signalClientStop(stop)
+
+	select {
+	case <-stop:
+	case <-time.After(100 * time.Millisecond):
+		t.Fatal("expected stop signal")
+	}
+	select {
+	case <-stop:
+		t.Fatal("expected a single stop signal")
+	default:
+	}
+}
+
+func TestWaitForClientReady(t *testing.T) {
+	t.Run("success", func(t *testing.T) {
+		ready := make(chan error, 1)
+		ready <- nil
+		if err := waitForClientReady(ready, time.Second); err != nil {
+			t.Fatalf("unexpected readiness error: %v", err)
+		}
+	})
+
+	t.Run("startup error", func(t *testing.T) {
+		ready := make(chan error, 1)
+		want := errors.New("connect failed")
+		ready <- want
+		if err := waitForClientReady(ready, time.Second); !errors.Is(err, want) {
+			t.Fatalf("got %v, want %v", err, want)
+		}
+	})
+
+	t.Run("timeout", func(t *testing.T) {
+		if err := waitForClientReady(make(chan error), time.Millisecond); err == nil {
+			t.Fatal("expected readiness timeout")
+		}
+	})
+}
+
+func TestMyClientSignalsReadinessOnlyOnce(t *testing.T) {
+	ready := make(chan error, 1)
+	client := &MyClient{ready: ready, readyOnce: &sync.Once{}}
+
+	client.signalReady(nil)
+	client.signalReady(errors.New("late failure"))
+
+	if err := <-ready; err != nil {
+		t.Fatalf("got %v, want nil", err)
+	}
+	select {
+	case err := <-ready:
+		t.Fatalf("unexpected second readiness result: %v", err)
+	default:
+	}
+}
+
+func TestCleanupOldGenerationPreservesNewGeneration(t *testing.T) {
+	oldClient := &whatsmeow.Client{}
+	newClient := &whatsmeow.Client{}
+	oldMyClient := &MyClient{}
+	newMyClient := &MyClient{}
+	oldStop := make(chan bool, 1)
+	newStop := make(chan bool, 1)
+	service := whatsmeowService{
+		clientPointer:   map[string]*whatsmeow.Client{"instance": newClient},
+		myClientPointer: map[string]*MyClient{"instance": newMyClient},
+		killChannel:     map[string]chan bool{"instance": newStop},
+		runtimeMu:       &sync.Mutex{},
+	}
+
+	service.cleanupClientRuntime("instance", oldClient, oldMyClient, oldStop)
+
+	if service.clientPointer["instance"] != newClient {
+		t.Fatal("old generation removed the new WhatsApp client")
+	}
+	if service.myClientPointer["instance"] != newMyClient {
+		t.Fatal("old generation removed the new event handler")
+	}
+	if service.killChannel["instance"] != newStop {
+		t.Fatal("old generation removed the new stop channel")
+	}
+}
