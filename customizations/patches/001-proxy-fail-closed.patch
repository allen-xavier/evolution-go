diff --git a/pkg/whatsmeow/service/proxy_policy_test.go b/pkg/whatsmeow/service/proxy_policy_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/whatsmeow/service/proxy_policy_test.go
@@ -0,0 +1,54 @@
+package whatsmeow_service
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/EvolutionAPI/evolution-go/pkg/config"
+	instance_model "github.com/EvolutionAPI/evolution-go/pkg/instance/model"
+)
+
+func TestResolveProxyConfigRequiresProxyWhenPolicyEnabled(t *testing.T) {
+	service := whatsmeowService{config: &config.Config{ProxyRequired: true}}
+
+	_, useProxy, err := service.resolveProxyConfig(&instance_model.Instance{})
+	if err == nil || useProxy {
+		t.Fatalf("expected missing proxy to be blocked, useProxy=%v err=%v", useProxy, err)
+	}
+	if !strings.Contains(err.Error(), "PROXY_REQUIRED") {
+		t.Fatalf("unexpected error: %v", err)
+	}
+}
+
+func TestResolveProxyConfigUsesInstanceProxy(t *testing.T) {
+	service := whatsmeowService{config: &config.Config{ProxyRequired: true}}
+	instance := &instance_model.Instance{
+		Proxy: `{"protocol":"http","host":"proxy.example","port":"823","username":"account","password":"secret"}`,
+	}
+
+	proxyConfig, useProxy, err := service.resolveProxyConfig(instance)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !useProxy || proxyConfig.Host != "proxy.example" || proxyConfig.Port != "823" {
+		t.Fatalf("unexpected proxy resolution: %#v, useProxy=%v", proxyConfig, useProxy)
+	}
+}
+
+func TestResolveProxyConfigNeverIgnoresInvalidStoredProxy(t *testing.T) {
+	service := whatsmeowService{config: &config.Config{}}
+
+	_, useProxy, err := service.resolveProxyConfig(&instance_model.Instance{Proxy: `{"host":`})
+	if err == nil || useProxy {
+		t.Fatalf("expected invalid stored proxy to be blocked, useProxy=%v err=%v", useProxy, err)
+	}
+}
+
+func TestResolveProxyConfigAllowsDirectOnlyWhenPolicyDisabled(t *testing.T) {
+	service := whatsmeowService{config: &config.Config{}}
+
+	_, useProxy, err := service.resolveProxyConfig(&instance_model.Instance{})
+	if err != nil || useProxy {
+		t.Fatalf("expected direct connection to remain available when policy is disabled, useProxy=%v err=%v", useProxy, err)
+	}
+}
