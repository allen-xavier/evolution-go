+func (w whatsmeowService) resolveProxyConfig(instance *instance_model.Instance) (ProxyConfig, bool, error) {
+	var proxyConfig ProxyConfig
+	hasInstanceProxy := strings.TrimSpace(instance.Proxy) != ""
+	hasGlobalProxy := strings.TrimSpace(w.config.ProxyHost) != "" ||
+		strings.TrimSpace(w.config.ProxyPort) != "" ||
+		strings.TrimSpace(w.config.ProxyUsername) != "" ||
+		w.config.ProxyPassword != ""
+
+	if hasInstanceProxy {
+		if err := json.Unmarshal([]byte(instance.Proxy), &proxyConfig); err != nil {
+			return ProxyConfig{}, false, fmt.Errorf("stored proxy configuration is invalid: %w", err)
+		}
+	}
+
+	if !hasInstanceProxy && !hasGlobalProxy {
+		if w.config.ProxyRequired {
+			return ProxyConfig{}, false, errors.New("PROXY_REQUIRED is enabled and this instance has no proxy")
+		}
+		return ProxyConfig{}, false, nil
+	}
+
+	if proxyConfig.Protocol == "" {
+		proxyConfig.Protocol = w.config.ProxyProtocol
+	}
+	if proxyConfig.Host == "" {
+		proxyConfig.Host = w.config.ProxyHost
+	}
+	if proxyConfig.Port == "" {
+		proxyConfig.Port = w.config.ProxyPort
+	}
+	if proxyConfig.Username == "" {
+		proxyConfig.Username = w.config.ProxyUsername
+	}
+	if proxyConfig.Password == "" {
+		proxyConfig.Password = w.config.ProxyPassword
+	}
+
+	if _, err := utils.BuildProxyAddress(proxyConfig.Protocol, proxyConfig.Host, proxyConfig.Port, proxyConfig.Username, proxyConfig.Password); err != nil {
+		return ProxyConfig{}, false, err
+	}
+	return proxyConfig, true, nil
+}
+
+func (w whatsmeowService) blockConnectionForProxy(instance *instance_model.Instance, err error) {
+	reason := fmt.Sprintf("Connection blocked by proxy policy: %v", err)
+	w.loggerWrapper.GetLogger(instance.Id).LogError("[%s] %s", instance.Id, reason)
+	instance.Connected = false
+	instance.DisconnectReason = reason
+	if updateErr := w.instanceRepository.UpdateConnected(instance.Id, false, reason); updateErr != nil {
+		w.loggerWrapper.GetLogger(instance.Id).LogError("[%s] Failed to persist proxy policy failure: %v", instance.Id, updateErr)
+	}
+}
