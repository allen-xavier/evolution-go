diff --git a/pkg/instance/service/connection_lifecycle_test.go b/pkg/instance/service/connection_lifecycle_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/instance/service/connection_lifecycle_test.go
@@ -0,0 +1,24 @@
+package instance_service
+
+import "testing"
+
+func TestDecideClientConnectionAction(t *testing.T) {
+	tests := []struct {
+		name      string
+		exists    bool
+		connected bool
+		want      clientConnectionAction
+	}{
+		{name: "missing client starts a new runtime", exists: false, connected: false, want: clientConnectionStart},
+		{name: "connected client is reused", exists: true, connected: true, want: clientConnectionReuse},
+		{name: "disconnected client is restarted", exists: true, connected: false, want: clientConnectionRestart},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			if got := decideClientConnectionAction(test.exists, test.connected); got != test.want {
+				t.Fatalf("expected action %d, got %d", test.want, got)
+			}
+		})
+	}
+}
