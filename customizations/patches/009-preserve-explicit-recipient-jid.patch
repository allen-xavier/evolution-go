+package send_service
+
+import "testing"
+
+func TestValidateMessageFieldsWithFormatJIDFalsePreservesBrazilianNinthDigit(t *testing.T) {
+	formatJID := false
+	recipient, err := validateMessageFields("5583921604543", &formatJID, nil, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := recipient.String(); got != "5583921604543@s.whatsapp.net" {
+		t.Fatalf("recipient = %q, want %q", got, "5583921604543@s.whatsapp.net")
+	}
+}
+
+func TestValidateMessageFieldsWithFormatJIDTrueKeepsLegacyBrazilianFormatting(t *testing.T) {
+	formatJID := true
+	recipient, err := validateMessageFields("5583921604543", &formatJID, nil, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := recipient.String(); got != "+558321604543@s.whatsapp.net" {
+		t.Fatalf("recipient = %q, want legacy fallback %q", got, "+558321604543@s.whatsapp.net")
+	}
+}
