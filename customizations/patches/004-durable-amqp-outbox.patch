diff --git a/pkg/events/rabbitmq/outbox.go b/pkg/events/rabbitmq/outbox.go
new file mode 100644
index 0000000..caafb6c
--- /dev/null
+++ b/pkg/events/rabbitmq/outbox.go
@@ -0,0 +1,232 @@
+package rabbitmq_producer
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"time"
+
+	"github.com/google/uuid"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+const (
+	outboxBatchSize = 100
+	outboxLockTTL   = time.Minute
+)
+
+type amqpOutboxMessage struct {
+	ID             string     `gorm:"type:uuid;primaryKey"`
+	EventKey       string     `gorm:"size:64;uniqueIndex;not null"`
+	QueueName      string     `gorm:"size:191;not null;index"`
+	Payload        []byte     `gorm:"type:bytea;not null"`
+	RabbitMQEnable string     `gorm:"size:32;not null"`
+	UserID         string     `gorm:"size:191;not null;index"`
+	Attempts       int        `gorm:"not null;default:0"`
+	NextAttemptAt  time.Time  `gorm:"not null;index"`
+	LastError      string     `gorm:"type:text"`
+	LockedUntil    *time.Time `gorm:"index"`
+	LockedBy       string     `gorm:"size:64;index"`
+	CreatedAt      time.Time
+	UpdatedAt      time.Time
+}
+
+func (amqpOutboxMessage) TableName() string {
+	return "evolution_amqp_outbox"
+}
+
+func MigrateOutbox(db *gorm.DB) error {
+	if db == nil {
+		return fmt.Errorf("database is nil")
+	}
+	return db.AutoMigrate(&amqpOutboxMessage{})
+}
+
+func newOutboxID() string {
+	return uuid.NewString()
+}
+
+func outboxEventKey(queueName string, payload []byte) string {
+	digest := sha256.New()
+	_, _ = digest.Write([]byte(queueName))
+	_, _ = digest.Write([]byte{0})
+	_, _ = digest.Write(payload)
+	return hex.EncodeToString(digest.Sum(nil))
+}
+
+func outboxRetryDelay(attempt int) time.Duration {
+	if attempt < 1 {
+		attempt = 1
+	}
+
+	delay := 5 * time.Second
+	for step := 1; step < attempt && delay < 5*time.Minute; step++ {
+		delay *= 2
+	}
+	if delay > 5*time.Minute {
+		return 5 * time.Minute
+	}
+	return delay
+}
+
+func truncateOutboxError(err error) string {
+	if err == nil {
+		return ""
+	}
+	const limit = 4000
+	message := err.Error()
+	if len(message) <= limit {
+		return message
+	}
+	return message[:limit]
+}
+
+func (p *rabbitMQProducer) enqueueOutbox(
+	queueName string,
+	payload []byte,
+	rabbitmqEnable string,
+	userID string,
+) (bool, error) {
+	now := time.Now().UTC()
+	job := amqpOutboxMessage{
+		ID:             newOutboxID(),
+		EventKey:       outboxEventKey(queueName, payload),
+		QueueName:      queueName,
+		Payload:        append([]byte(nil), payload...),
+		RabbitMQEnable: rabbitmqEnable,
+		UserID:         userID,
+		NextAttemptAt:  now,
+		CreatedAt:      now,
+		UpdatedAt:      now,
+	}
+
+	result := p.db.Clauses(clause.OnConflict{
+		Columns:   []clause.Column{{Name: "event_key"}},
+		DoNothing: true,
+	}).Create(&job)
+	return result.RowsAffected == 1, result.Error
+}
+
+func (p *rabbitMQProducer) signalWorker() {
+	select {
+	case p.wakeWorker <- struct{}{}:
+	default:
+	}
+}
+
+func (p *rabbitMQProducer) runOutboxWorker() {
+	ticker := time.NewTicker(5 * time.Second)
+	defer ticker.Stop()
+
+	p.signalWorker()
+	for {
+		select {
+		case <-ticker.C:
+		case <-p.wakeWorker:
+		}
+		p.processDueOutbox()
+	}
+}
+
+func (p *rabbitMQProducer) processDueOutbox() {
+	for {
+		jobs, err := p.claimDueOutbox(outboxBatchSize)
+		if err != nil {
+			p.loggerWrapper.GetLogger("system").LogError("Failed to claim AMQP outbox messages: %v", err)
+			return
+		}
+		if len(jobs) == 0 {
+			return
+		}
+
+		for _, job := range jobs {
+			if err := p.publishConfirmed(job); err != nil {
+				if updateErr := p.markOutboxRetry(job, err); updateErr != nil {
+					p.loggerWrapper.GetLogger(job.UserID).LogError(
+						"[%s] Failed to update AMQP outbox retry state: %v",
+						job.UserID,
+						updateErr,
+					)
+				}
+				p.loggerWrapper.GetLogger(job.UserID).LogError(
+					"[%s] AMQP delivery failed; event remains persisted for retry - queue: %s, error: %v",
+					job.UserID,
+					job.QueueName,
+					err,
+				)
+				continue
+			}
+
+			result := p.db.
+				Where("id = ? AND locked_by = ?", job.ID, p.workerID).
+				Delete(&amqpOutboxMessage{})
+			if result.Error != nil {
+				p.loggerWrapper.GetLogger(job.UserID).LogError(
+					"[%s] RabbitMQ confirmed delivery but outbox cleanup failed for queue %s: %v",
+					job.UserID,
+					job.QueueName,
+					result.Error,
+				)
+				continue
+			}
+			p.loggerWrapper.GetLogger(job.UserID).LogInfo(
+				"[%s] AMQP outbox event delivered and confirmed - queue: %s",
+				job.UserID,
+				job.QueueName,
+			)
+		}
+
+		if len(jobs) < outboxBatchSize {
+			return
+		}
+	}
+}
+
+func (p *rabbitMQProducer) claimDueOutbox(limit int) ([]amqpOutboxMessage, error) {
+	now := time.Now().UTC()
+	lockedUntil := now.Add(outboxLockTTL)
+	jobs := make([]amqpOutboxMessage, 0, limit)
+
+	err := p.db.Transaction(func(tx *gorm.DB) error {
+		if err := tx.
+			Clauses(clause.Locking{Strength: "UPDATE", Options: "SKIP LOCKED"}).
+			Where("next_attempt_at <= ? AND (locked_until IS NULL OR locked_until < ?)", now, now).
+			Order("created_at ASC").
+			Limit(limit).
+			Find(&jobs).Error; err != nil {
+			return err
+		}
+		if len(jobs) == 0 {
+			return nil
+		}
+
+		ids := make([]string, 0, len(jobs))
+		for index := range jobs {
+			ids = append(ids, jobs[index].ID)
+			jobs[index].LockedUntil = &lockedUntil
+			jobs[index].LockedBy = p.workerID
+		}
+
+		return tx.Model(&amqpOutboxMessage{}).
+			Where("id IN ?", ids).
+			Updates(map[string]interface{}{
+				"locked_until": lockedUntil,
+				"locked_by":    p.workerID,
+			}).Error
+	})
+	return jobs, err
+}
+
+func (p *rabbitMQProducer) markOutboxRetry(job amqpOutboxMessage, deliveryErr error) error {
+	attempts := job.Attempts + 1
+	return p.db.Model(&amqpOutboxMessage{}).
+		Where("id = ? AND locked_by = ?", job.ID, p.workerID).
+		Updates(map[string]interface{}{
+			"attempts":        attempts,
+			"next_attempt_at": time.Now().UTC().Add(outboxRetryDelay(attempts)),
+			"last_error":      truncateOutboxError(deliveryErr),
+			"locked_until":    nil,
+			"locked_by":       "",
+		}).Error
+}
diff --git a/pkg/events/rabbitmq/outbox_test.go b/pkg/events/rabbitmq/outbox_test.go
new file mode 100644
index 0000000..39e95c9
--- /dev/null
+++ b/pkg/events/rabbitmq/outbox_test.go
@@ -0,0 +1,200 @@
+package rabbitmq_producer
+
+import (
+	"bytes"
+	"os"
+	"strings"
+	"testing"
+	"time"
+
+	"gorm.io/driver/postgres"
+	"gorm.io/gorm"
+)
+
+func TestOutboxEventKeyIsDeterministicAndQueueScoped(t *testing.T) {
+	payload := []byte(`{"event":"Message","id":"abc"}`)
+	first := outboxEventKey("message", payload)
+	second := outboxEventKey("message", payload)
+	otherQueue := outboxEventKey("sendmessage", payload)
+
+	if first != second {
+		t.Fatalf("expected deterministic event key, got %q and %q", first, second)
+	}
+	if first == otherQueue {
+		t.Fatal("expected queue name to be part of the event key")
+	}
+	if len(first) != 64 {
+		t.Fatalf("expected SHA-256 hex key, got length %d", len(first))
+	}
+}
+
+func TestOutboxRetryDelayIsBounded(t *testing.T) {
+	cases := []struct {
+		attempt int
+		want    time.Duration
+	}{
+		{attempt: 0, want: 5 * time.Second},
+		{attempt: 1, want: 5 * time.Second},
+		{attempt: 2, want: 10 * time.Second},
+		{attempt: 3, want: 20 * time.Second},
+		{attempt: 10, want: 5 * time.Minute},
+	}
+
+	for _, testCase := range cases {
+		if got := outboxRetryDelay(testCase.attempt); got != testCase.want {
+			t.Fatalf("attempt %d: expected %s, got %s", testCase.attempt, testCase.want, got)
+		}
+	}
+}
+
+func TestTruncateOutboxError(t *testing.T) {
+	longMessage := strings.Repeat("x", 5000)
+	got := truncateOutboxError(testError(longMessage))
+	if len(got) != 4000 {
+		t.Fatalf("expected 4000-byte error, got %d", len(got))
+	}
+}
+
+type testError string
+
+func (err testError) Error() string {
+	return string(err)
+}
+
+func TestOutboxPostgresAndRabbitMQIntegration(t *testing.T) {
+	postgresDSN := os.Getenv("TEST_POSTGRES_DSN")
+	amqpURL := os.Getenv("TEST_AMQP_URL")
+	if postgresDSN == "" || amqpURL == "" {
+		t.Skip("TEST_POSTGRES_DSN and TEST_AMQP_URL are required for integration test")
+	}
+
+	db, err := gorm.Open(postgres.Open(postgresDSN), &gorm.Config{})
+	if err != nil {
+		t.Fatalf("open PostgreSQL: %v", err)
+	}
+	if err := MigrateOutbox(db); err != nil {
+		t.Fatalf("migrate outbox: %v", err)
+	}
+
+	suffix := strings.ToLower(strings.ReplaceAll(newOutboxID(), "-", ""))
+	queueName := "outbox-integration-" + suffix
+	payload := []byte(`{"event":"integration-test","id":"` + suffix + `"}`)
+	eventKey := outboxEventKey(queueName, payload)
+
+	producer := &rabbitMQProducer{
+		connStr:  "amqp://test:testpass@127.0.0.1:1/",
+		db:       db,
+		workerID: newOutboxID(),
+	}
+	recoveredProducer := &rabbitMQProducer{
+		connStr:  amqpURL,
+		db:       db,
+		workerID: newOutboxID(),
+	}
+	t.Cleanup(func() {
+		_ = db.Where("event_key = ?", eventKey).Delete(&amqpOutboxMessage{}).Error
+		if recoveredProducer.conn != nil && !recoveredProducer.conn.IsClosed() {
+			if channel, channelErr := recoveredProducer.conn.Channel(); channelErr == nil {
+				_, _ = channel.QueueDelete(queueName, false, false, false)
+				_ = channel.Close()
+			}
+			_ = recoveredProducer.conn.Close()
+		}
+	})
+
+	inserted, err := producer.enqueueOutbox(queueName, payload, "global", "integration")
+	if err != nil {
+		t.Fatalf("enqueue first event: %v", err)
+	}
+	if !inserted {
+		t.Fatal("expected first event to be inserted")
+	}
+
+	inserted, err = producer.enqueueOutbox(queueName, payload, "global", "integration")
+	if err != nil {
+		t.Fatalf("enqueue duplicate event: %v", err)
+	}
+	if inserted {
+		t.Fatal("expected duplicate event to be ignored")
+	}
+
+	jobs, err := producer.claimDueOutbox(10)
+	if err != nil {
+		t.Fatalf("claim due event: %v", err)
+	}
+	if len(jobs) != 1 {
+		t.Fatalf("expected one claimed event, got %d", len(jobs))
+	}
+	if jobs[0].LockedBy != producer.workerID {
+		t.Fatalf("expected worker lock %q, got %q", producer.workerID, jobs[0].LockedBy)
+	}
+
+	deliveryErr := producer.publishConfirmed(jobs[0])
+	if deliveryErr == nil {
+		t.Fatal("expected delivery to fail while RabbitMQ endpoint is unavailable")
+	}
+	if err := producer.markOutboxRetry(jobs[0], deliveryErr); err != nil {
+		t.Fatalf("persist retry state: %v", err)
+	}
+
+	var persisted amqpOutboxMessage
+	if err := db.Where("event_key = ?", eventKey).First(&persisted).Error; err != nil {
+		t.Fatalf("load persisted event after delivery failure: %v", err)
+	}
+	if persisted.Attempts != 1 {
+		t.Fatalf("expected one persisted attempt, got %d", persisted.Attempts)
+	}
+	if persisted.LastError == "" {
+		t.Fatal("expected delivery error to be persisted")
+	}
+
+	if err := db.Model(&amqpOutboxMessage{}).
+		Where("event_key = ?", eventKey).
+		Updates(map[string]interface{}{
+			"next_attempt_at": time.Now().UTC(),
+			"locked_until":    nil,
+			"locked_by":       "",
+		}).Error; err != nil {
+		t.Fatalf("make event due for simulated restart: %v", err)
+	}
+
+	jobs, err = recoveredProducer.claimDueOutbox(10)
+	if err != nil {
+		t.Fatalf("claim event after simulated restart: %v", err)
+	}
+	if len(jobs) != 1 {
+		t.Fatalf("expected one event after simulated restart, got %d", len(jobs))
+	}
+	if err := recoveredProducer.publishConfirmed(jobs[0]); err != nil {
+		t.Fatalf("publish with confirmation after recovery: %v", err)
+	}
+
+	channel, err := recoveredProducer.conn.Channel()
+	if err != nil {
+		t.Fatalf("open consumer channel: %v", err)
+	}
+	defer channel.Close()
+
+	delivery, ok, err := channel.Get(queueName, true)
+	if err != nil {
+		t.Fatalf("read published event: %v", err)
+	}
+	if !ok {
+		t.Fatal("expected a published event in RabbitMQ")
+	}
+	if !bytes.Equal(delivery.Body, payload) {
+		t.Fatalf("payload mismatch: expected %q, got %q", payload, delivery.Body)
+	}
+	if delivery.MessageId != eventKey {
+		t.Fatalf("message ID mismatch: expected %q, got %q", eventKey, delivery.MessageId)
+	}
+
+	result := db.Where("id = ? AND locked_by = ?", jobs[0].ID, recoveredProducer.workerID).
+		Delete(&amqpOutboxMessage{})
+	if result.Error != nil {
+		t.Fatalf("delete confirmed outbox event: %v", result.Error)
+	}
+	if result.RowsAffected != 1 {
+		t.Fatalf("expected one deleted outbox event, got %d", result.RowsAffected)
+	}
+}
