+package whatsmeow_service
+
+import (
+	"testing"
+
+	"go.mau.fi/whatsmeow/store"
+)
+
+func TestApplyWhatsAppClientVersionUpdatesHandshakePayload(t *testing.T) {
+	original := store.GetWAVersion()
+	defer applyWhatsAppClientVersion(clientVersion{
+		Major: int(original[0]),
+		Minor: int(original[1]),
+		Patch: int(original[2]),
+	})
+
+	want := clientVersion{Major: 2, Minor: 3000, Patch: 1044006379}
+	if !applyWhatsAppClientVersion(want) {
+		t.Fatal("expected a valid version to be applied")
+	}
+
+	gotVersion := store.GetWAVersion()
+	if gotVersion != (store.WAVersionContainer{2, 3000, 1044006379}) {
+		t.Fatalf("store version = %s", gotVersion.String())
+	}
+
+	payloadVersion := store.BaseClientPayload.GetUserAgent().GetAppVersion()
+	if payloadVersion.GetPrimary() != uint32(want.Major) ||
+		payloadVersion.GetSecondary() != uint32(want.Minor) ||
+		payloadVersion.GetTertiary() != uint32(want.Patch) {
+		t.Fatalf(
+			"handshake payload version = %d.%d.%d",
+			payloadVersion.GetPrimary(),
+			payloadVersion.GetSecondary(),
+			payloadVersion.GetTertiary(),
+		)
+	}
+
+	deviceVersion := store.DeviceProps.GetVersion()
+	if deviceVersion.GetPrimary() != uint32(want.Major) ||
+		deviceVersion.GetSecondary() != uint32(want.Minor) ||
+		deviceVersion.GetTertiary() != uint32(want.Patch) {
+		t.Fatalf(
+			"device props version = %d.%d.%d",
+			deviceVersion.GetPrimary(),
+			deviceVersion.GetSecondary(),
+			deviceVersion.GetTertiary(),
+		)
+	}
+}
