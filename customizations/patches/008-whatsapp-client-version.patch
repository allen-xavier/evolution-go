 	Patch int
 }
 
+var whatsAppVersionMu sync.Mutex
+
+func applyWhatsAppClientVersion(version clientVersion) bool {
+	if version.Major <= 0 || version.Minor <= 0 || version.Patch <= 0 {
+		return false
+	}
+
+	waVersion := store.WAVersionContainer{
+		uint32(version.Major),
+		uint32(version.Minor),
+		uint32(version.Patch),
+	}
+
+	whatsAppVersionMu.Lock()
+	defer whatsAppVersionMu.Unlock()
+
+	store.SetWAVersion(waVersion)
+
+	// Backport tulir/whatsmeow a763037. The vendored library updates the
+	// version hash, but leaves the already-created handshake payload stale.
+	store.BaseClientPayload.UserAgent.AppVersion = waVersion.ProtoAppVersion()
+
+	store.DeviceProps.Version.Primary = proto.Uint32(waVersion[0])
+	store.DeviceProps.Version.Secondary = proto.Uint32(waVersion[1])
+	store.DeviceProps.Version.Tertiary = proto.Uint32(waVersion[2])
+	return true
+}
