+func webhookResponseForLog(body []byte) string {
+	const maxLogBytes = 2048
+
+	response := strings.TrimSpace(string(body))
+	response = strings.Join(strings.Fields(response), " ")
+	if len(response) <= maxLogBytes {
+		return response
+	}
+	return response[:maxLogBytes] + "...(truncated)"
