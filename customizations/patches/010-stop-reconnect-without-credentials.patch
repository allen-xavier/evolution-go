new file mode 100644
index 0000000..a0cf519
--- /dev/null
+++ b/pkg/whatsmeow/service/reconnect_credentials.go
@@ -0,0 +1,34 @@
+package whatsmeow_service
+
+import (
+	"database/sql"
+	"errors"
+	"strings"
+
+	"go.mau.fi/whatsmeow/types"
+)
+
+// storedCredentialsExist reports whether the WhatsApp device credentials of an
+// instance are still stored. WhatsApp removes them when the linked device is
+// logged out or the number is blocked; then only a new QR code scan reconnects.
+// A nil database means the check is not possible and is reported as an error.
+func storedCredentialsExist(authDB *sql.DB, instanceJID string) (bool, error) {
+	instanceJID = strings.TrimSpace(instanceJID)
+	if instanceJID == "" {
+		return false, nil
+	}
+	if authDB == nil {
+		return false, errNoAuthDatabase
+	}
+	jid, err := types.ParseJID(instanceJID)
+	if err != nil {
+		return false, err
+	}
+	var count int
+	if err := authDB.QueryRow("SELECT COUNT(*) FROM whatsmeow_device WHERE jid = $1", jid.String()).Scan(&count); err != nil {
+		return false, err
+	}
+	return count > 0, nil
+}
+
+var errNoAuthDatabase = errors.New("auth database is not configured")
diff --git a/pkg/whatsmeow/service/reconnect_credentials_test.go b/pkg/whatsmeow/service/reconnect_credentials_test.go
new file mode 100644
index 0000000..665e92a
--- /dev/null
+++ b/pkg/whatsmeow/service/reconnect_credentials_test.go
@@ -0,0 +1,47 @@
+package whatsmeow_service
+
+import (
+	"database/sql"
+	"testing"
+
+	_ "modernc.org/sqlite"
+)
+
+func TestStoredCredentialsExist(t *testing.T) {
+	db, err := sql.Open("sqlite", "file:credentials?mode=memory&cache=shared")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	if _, err := db.Exec(`CREATE TABLE whatsmeow_device (jid TEXT PRIMARY KEY)`); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := db.Exec(`INSERT INTO whatsmeow_device (jid) VALUES ('553121202418:18@s.whatsapp.net')`); err != nil {
+		t.Fatal(err)
+	}
+
+	tests := []struct {
+		name string
+		jid  string
+		want bool
+	}{
+		{name: "linked device still stored", jid: "553121202418:18@s.whatsapp.net", want: true},
+		{name: "logged out device was removed", jid: "557531998461:3@s.whatsapp.net", want: false},
+		{name: "instance never paired", jid: "", want: false},
+	}
+	for _, test := range tests {
+		got, err := storedCredentialsExist(db, test.jid)
+		if err != nil {
+			t.Fatalf("%s: unexpected error: %v", test.name, err)
+		}
+		if got != test.want {
+			t.Fatalf("%s: got %v, want %v", test.name, got, test.want)
+		}
+	}
+}
+
+func TestStoredCredentialsCheckWithoutDatabaseIsAnError(t *testing.T) {
+	if _, err := storedCredentialsExist(nil, "553121202418:18@s.whatsapp.net"); err == nil {
+		t.Fatal("without the auth database the check must fail so the reconnect keeps its old behaviour")
+	}
+}
