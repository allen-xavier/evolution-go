diff --git a/pkg/whatsmeow/service/auth_store.go b/pkg/whatsmeow/service/auth_store.go
new file mode 100644
index 0000000..d0d88b4
--- /dev/null
+++ b/pkg/whatsmeow/service/auth_store.go
@@ -0,0 +1,52 @@
+package whatsmeow_service
+
+import (
+	"context"
+	"database/sql"
+	"fmt"
+	"time"
+
+	"go.mau.fi/whatsmeow/store/sqlstore"
+	waLog "go.mau.fi/whatsmeow/util/log"
+)
+
+// Limites do pool do banco de autenticação (Postgres). O fork EvolutionAPI do
+// whatsmeow aplicava esses valores dentro de sqlstore.New; o whatsmeow oficial
+// não limita nada. Cada StartClient abre o próprio container, então sem limite
+// uma rajada de reconexões pode esgotar as conexões do PostgreSQL.
+const (
+	authDBMaxOpenConns    = 25
+	authDBMaxIdleConns    = 5
+	authDBConnMaxLifetime = 5 * time.Minute
+	authDBConnMaxIdleTime = 1 * time.Minute
+)
+
+// applyAuthDBPoolLimits aplica ao sql.DB os mesmos limites do fork antigo.
+func applyAuthDBPoolLimits(db *sql.DB) {
+	db.SetMaxOpenConns(authDBMaxOpenConns)
+	db.SetMaxIdleConns(authDBMaxIdleConns)
+	db.SetConnMaxLifetime(authDBConnMaxLifetime)
+	db.SetConnMaxIdleTime(authDBConnMaxIdleTime)
+}
+
+// newAuthStoreContainer substitui sqlstore.New: abre o banco com o mesmo
+// driver/DSN, limita o pool quando é Postgres (como o fork fazia), cria o
+// container com NewWithDB e roda as migrações. Container.Close continua
+// fechando o sql.DB.
+func newAuthStoreContainer(ctx context.Context, dialect, address string, log waLog.Logger) (*sqlstore.Container, error) {
+	db, err := sql.Open(dialect, address)
+	if err != nil {
+		return nil, fmt.Errorf("failed to open database: %w", err)
+	}
+
+	if dialect == "postgres" {
+		applyAuthDBPoolLimits(db)
+	}
+
+	container := sqlstore.NewWithDB(db, dialect, log)
+	if err := container.Upgrade(ctx); err != nil {
+		_ = container.Close()
+		return nil, fmt.Errorf("failed to upgrade database: %w", err)
+	}
+	return container, nil
+}
diff --git a/pkg/whatsmeow/service/auth_store_test.go b/pkg/whatsmeow/service/auth_store_test.go
new file mode 100644
index 0000000..7036a14
--- /dev/null
+++ b/pkg/whatsmeow/service/auth_store_test.go
@@ -0,0 +1,132 @@
+package whatsmeow_service
+
+import (
+	"context"
+	"database/sql"
+	"database/sql/driver"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"testing"
+
+	_ "modernc.org/sqlite"
+)
+
+// Driver falso: só abre conexões, para conferir o pool sem banco de verdade.
+type poolTestDriver struct{}
+
+type poolTestConn struct{}
+
+func (poolTestDriver) Open(string) (driver.Conn, error) { return poolTestConn{}, nil }
+
+func (poolTestConn) Prepare(string) (driver.Stmt, error) {
+	return nil, errors.New("not supported")
+}
+func (poolTestConn) Close() error              { return nil }
+func (poolTestConn) Begin() (driver.Tx, error) { return nil, errors.New("not supported") }
+
+func init() {
+	sql.Register("evolution-auth-pool-test", poolTestDriver{})
+}
+
+func TestApplyAuthDBPoolLimits(t *testing.T) {
+	db, err := sql.Open("evolution-auth-pool-test", "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+
+	applyAuthDBPoolLimits(db)
+
+	if got := db.Stats().MaxOpenConnections; got != 25 {
+		t.Fatalf("MaxOpenConnections = %d, want 25", got)
+	}
+
+	// Abre 10 conexões ao mesmo tempo e devolve todas: só 5 podem ficar ociosas.
+	ctx := context.Background()
+	conns := make([]*sql.Conn, 0, 10)
+	for i := 0; i < 10; i++ {
+		conn, err := db.Conn(ctx)
+		if err != nil {
+			t.Fatal(err)
+		}
+		conns = append(conns, conn)
+	}
+	if got := db.Stats().OpenConnections; got != 10 {
+		t.Fatalf("OpenConnections = %d, want 10", got)
+	}
+	for _, conn := range conns {
+		_ = conn.Close()
+	}
+	stats := db.Stats()
+	if stats.Idle != 5 {
+		t.Fatalf("Idle = %d, want 5", stats.Idle)
+	}
+	if stats.MaxIdleClosed != 5 {
+		t.Fatalf("MaxIdleClosed = %d, want 5", stats.MaxIdleClosed)
+	}
+
+	if authDBConnMaxLifetime.Minutes() != 5 || authDBConnMaxIdleTime.Minutes() != 1 {
+		t.Fatalf("lifetime/idle time = %s/%s, want 5m/1m", authDBConnMaxLifetime, authDBConnMaxIdleTime)
+	}
+}
+
+func TestNewAuthStoreContainerSQLiteUpgradesAndCloses(t *testing.T) {
+	dsn := fmt.Sprintf("file:%s?_pragma=foreign_keys(1)&_busy_timeout=5000&cache=shared&mode=rwc&_journal_mode=WAL", filepath.Join(t.TempDir(), "main.db"))
+	container, err := newAuthStoreContainer(context.Background(), "sqlite", dsn, nil)
+	if err != nil {
+		t.Fatalf("newAuthStoreContainer: %v", err)
+	}
+	devices, err := container.GetAllDevices(context.Background())
+	if err != nil {
+		t.Fatalf("GetAllDevices after upgrade: %v", err)
+	}
+	if len(devices) != 0 {
+		t.Fatalf("devices = %d, want 0", len(devices))
+	}
+	if err := container.Close(); err != nil {
+		t.Fatalf("Close: %v", err)
+	}
+	if _, err := container.GetAllDevices(context.Background()); err == nil {
+		t.Fatal("expected an error after Close")
+	}
+}
+
+func TestNewAuthStoreContainerSQLiteWithoutForeignKeysFails(t *testing.T) {
+	dsn := "file:" + filepath.Join(t.TempDir(), "main.db") + "?mode=rwc"
+	if _, err := newAuthStoreContainer(context.Background(), "sqlite", dsn, nil); err == nil {
+		t.Fatal("expected upgrade error without foreign keys")
+	}
+}
+
+// Opcional: com EVOLUTION_TEST_POSTGRES_DSN, roda as migrações num Postgres de
+// verdade (banco novo ou já existente do fork, versão 13).
+func TestNewAuthStoreContainerPostgres(t *testing.T) {
+	dsn := os.Getenv("EVOLUTION_TEST_POSTGRES_DSN")
+	if dsn == "" {
+		t.Skip("EVOLUTION_TEST_POSTGRES_DSN not set")
+	}
+	db, err := sql.Open("postgres", dsn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+
+	container, err := newAuthStoreContainer(context.Background(), "postgres", dsn, nil)
+	if err != nil {
+		t.Fatalf("newAuthStoreContainer: %v", err)
+	}
+	defer container.Close()
+
+	if _, err := container.GetAllDevices(context.Background()); err != nil {
+		t.Fatalf("GetAllDevices after upgrade: %v", err)
+	}
+	var version, compat int
+	if err := db.QueryRow("SELECT version, compat FROM whatsmeow_version").Scan(&version, &compat); err != nil {
+		t.Fatal(err)
+	}
+	if version != 16 || compat != 8 {
+		t.Fatalf("whatsmeow_version = %d (compat %d), want 16 (compat 8)", version, compat)
+	}
+}
