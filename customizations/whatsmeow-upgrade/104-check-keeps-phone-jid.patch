+// phoneJIDForCheck devolve o JID de telefone de uma resposta do IsOnWhatsApp: o
+// whatsmeow oficial (6e4c341) põe o LID em JID e o telefone em PhoneNumber.
+func phoneJIDForCheck(item types.IsOnWhatsAppResponse) types.JID {
+	if item.JID.Server == types.HiddenUserServer && !item.PhoneNumber.IsEmpty() {
+		return item.PhoneNumber
+	}
+	return item.JID
+}
