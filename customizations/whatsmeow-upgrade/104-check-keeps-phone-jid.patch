+package send_service
+
+import (
+	"testing"
+
+	"go.mau.fi/whatsmeow/types"
+)
+
+// O whatsmeow oficial devolve o LID em JID e o telefone em PhoneNumber.
+func TestPhoneJIDForCheckPrefersPhone(t *testing.T) {
+	phone := types.NewJID("5511999990001", types.DefaultUserServer)
+	lid := types.NewJID("27535706447996", types.HiddenUserServer)
+
+	if got := phoneJIDForCheck(types.IsOnWhatsAppResponse{JID: lid, PhoneNumber: phone, IsIn: true}); got != phone {
+		t.Fatalf("expected phone JID, got %s", got)
+	}
+	if got := phoneJIDForCheck(types.IsOnWhatsAppResponse{JID: phone, IsIn: true}); got != phone {
+		t.Fatalf("phone JID must stay as is, got %s", got)
+	}
+	if got := phoneJIDForCheck(types.IsOnWhatsAppResponse{JID: lid, IsIn: true}); got != lid {
+		t.Fatalf("without phone number keep the LID, got %s", got)
+	}
+}
